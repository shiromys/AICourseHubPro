+def _fmt_uptime(seconds):
+    seconds = int(seconds)
+    d, r = divmod(seconds, 86400); h, r = divmod(r, 3600); m, _ = divmod(r, 60)
+    return (f"{d}d " if d else "") + (f"{h}h " if (d or h) else "") + f"{m}m"
