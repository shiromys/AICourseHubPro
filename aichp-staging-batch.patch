+    if not path.startswith('/') or path.startswith('/admin'):
+        return jsonify({"ok": True}), 200
+    if throttled('track', str(user_id), 90, 60):
+        return jsonify({"ok": True}), 200
+    log_activity(user_id, 'page_view', path=path, detail=(str(data.get('title') or '')[:200] or None))
+    return jsonify({"ok": True}), 200
