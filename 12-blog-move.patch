@@ -11,6 +12,7 @@ export default function RouteSeo() {
   useEffect(() => {
     const p = pathname.length > 1 ? pathname.replace(/\/+$/, '') : pathname;
     if (/^\/courses\/[^/]+$/.test(p)) return; // the course page sets its own
+    if (/^\/blog\/[^/]+$/.test(p)) return; // so does each blog article
